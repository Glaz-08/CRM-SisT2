# Backend
PORT=3000
CORS_ORIGIN=http://localhost:8080

# PostgreSQL del profesor (Neon)
DB_HOST=tu-host.neon.tech
DB_PORT=5432
DB_NAME=tu_base
DB_USER=tu_usuario
DB_PASSWORD="SuContrasenaSegura#2026!"
DB_SCHEMA=crm

DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Se mantiene por compatibilidad; database.config fuerza synchronize=false.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=10000

TZ=America/Santiago

# Validación contra maestros externos.
# Cliente:
#   db   -> lee "master"."cliente" en la misma base del CRM
#   http -> usa CLIENTE_MAESTRO_URL
#   mock -> datos en memoria para tests/demo
# Empleado:
#   mock -> datos en memoria mientras no exista el esquema RRHH
#   http -> usa EMPLEADO_MAESTRO_URL
# MAESTROS_MODE queda como fallback si no se define el modo específico.
VALIDAR_CLIENTE=true
VALIDAR_EMPLEADO=true
CLIENTE_MAESTRO_MODE=db
EMPLEADO_MAESTRO_MODE=mock
CLIENTE_MAESTRO_URL=
EMPLEADO_MAESTRO_URL=
HTTP_TIMEOUT_MS=3000
INTEGRATION_API_KEY=

# ERP simulado para demo (solo desarrollo/demo). En producción debe ser false.
# Para la demo local: ENABLE_MOCKS=true.
ENABLE_MOCKS=false

# Entrega de eventos: nest (solo bus interno) | http (bus + webhook)
EVENT_DELIVERY_MODE=http
FACTURACION_WEBHOOK_URL=http://localhost:3000/api/mock/facturacion/seguimientos
INVENTARIO_WEBHOOK_URL=http://localhost:3000/api/mock/inventario/clientes
EVENT_DELIVERY_TIMEOUT_MS=3000
EVENT_DELIVERY_RETRIES=2
